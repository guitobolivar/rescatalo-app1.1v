# Rescátalo Venezuela - Environment Variables Configuration (.env.example)
# Copia este archivo como .env o configúralo en Vercel / Netlify / AI Studio

# ==========================================
# 1. FIREBASE CONFIGURATION (TIEMPO REAL / BASE DE DATOS)
# ==========================================
# Obtén estas credenciales en Firebase Console -> Configuración del Proyecto -> General
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="rescatalo-venezuela.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="rescatalo-venezuela"
VITE_FIREBASE_STORAGE_BUCKET="rescatalo-venezuela.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
# Opcional si usas una base de datos específica de Firestore
VITE_FIREBASE_DATABASE_ID="(default)"

# ==========================================
# 2. SUPABASE CONFIGURATION (OPCIONAL ALTERNATIVA)
# ==========================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ==========================================
# 3. WEB PUSH & NOTIFICATIONS (VAPID PUBLIC KEY)
# ==========================================
VITE_VAPID_PUBLIC_KEY="BEl62iENCG2NXXXXXXXXXXXXXXX_XXXXXXXXXX"

# ==========================================
# 4. APP & DEPLOYMENT URL (VERCEL / NETLIFY)
# ==========================================
VITE_APP_URL="https://rescatalo-venezuela.vercel.app"
APP_URL="https://rescatalo-venezuela.vercel.app"

# ==========================================
# 5. GEMINI API (OPCIONAL)
# ==========================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"

